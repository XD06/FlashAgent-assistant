{
  "name": "flashagent-assistant",
  "version": "0.8.6",
  "description": "FlashAgent-assistant: fast answers and lightweight Agent workflows｜快速划词问答、截图识图与轻量 Agent 工作流。",
  "main": "out/main/index.cjs",
  "author": "XD06",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XD06/FlashAgent-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/XD06/FlashAgent-assistant/issues"
  },
  "homepage": "https://github.com/XD06/FlashAgent-assistant#readme",
  "keywords": [
    "electron",
    "ai-assistant",
    "selection",
    "text-selection",
    "ai",
    "quick-answer",
    "agent",
    "agent-workflow",
    "desktop-app",
    "screenshot",
    "vision-ai",
    "openai-compatible",
    "anthropic",
    "mcp",
    "translation",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "start": "node scripts/launch.mjs preview",
    "build": "pnpm typecheck && electron-vite build",
    "prepare:selection-hook": "node scripts/prepare-selection-hook.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e:compaction": "esbuild sandbox-e2e/run-e2e.ts --bundle --platform=node --format=cjs --outfile=sandbox-e2e/run-e2e.cjs --external:undici --log-level=warning && node sandbox-e2e/run-e2e.cjs",
    "e2e:agent-context": "esbuild sandbox-e2e/run-agent-context.ts --bundle --platform=node --format=cjs --outfile=sandbox-e2e/run-agent-context.cjs --external:undici --log-level=warning && node sandbox-e2e/run-agent-context.cjs",
    "dist:mac": "pnpm build && pnpm prepare:selection-hook && electron-builder --mac dmg zip --publish never",
    "dist:win": "pnpm build && pnpm prepare:selection-hook && node scripts/dist-win.cjs --win portable --x64 --publish never",
    "dist:win:full": "pnpm build && pnpm prepare:selection-hook && node scripts/dist-win.cjs --win nsis portable --x64 --publish never",
    "dist:win:arm64": "pnpm build && pnpm prepare:selection-hook && node scripts/dist-win.cjs --win nsis portable --arm64 --publish never",
    "pack:portable": "pnpm build && node scripts/package-portable.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-store": "^8.2.0",
    "selection-hook": "2.0.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.4.12",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "electron-vite": "^2.3.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
